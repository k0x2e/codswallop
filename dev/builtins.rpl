( ### Conversions )

(Make a builtin)
{ :name: >BIN
  :args: #4
  :hint: "Build a new built-in from a hint string, symbol name, an argument count, and a dispatch table in the form of:
  { { code objtype1 objtype2 ... } ... }"
  :table:
  { { :: >bin setbintable ;
      Types.List Types.Integer Types.String Types.Symbol } } }
I*.stobin

(Hook a builtin)
({ :name: HOOK
  :args: #2
  :hint: "Hook new dispatch lines into an extant builtin, in the same fashion as >BIN."
  :table:
  { { :: binhook drop ; Types.List Types.Builtin } } }
I*.stobin)

(Make a tag)
{ :name: >TAG
  :args: #2
  :hint: "Prepare a new tag object from any object and a non-dotted symbol."
  :table:
  { { >tag Types.Any Types.Symbol } } }
I*.stobin

(Make directory)
{ :name: MKDIR
  :args: #0
  :hint: "Create a new empty directory."
  :table: { { mkdir } } }
I*.stobin

(Coerce to integer)
{ :name: >INT
  :args: #1
  :hint: "Make a number or string an integer."
  :table:
  { { num>int Types.Float }
    { str>int Types.String }
    { (Fageddaboudit) Types.Integer } } }
I*.stobin

(Coerce to float)
{ :name: >FLOAT
  :args: #1
  :hint: "Make a number or string a float."
  :table:
  { { num>float   Types.Integer }
    { str>float   Types.String }
    { (Fageddaboudit) Types.Float } } }
I*.stobin

(Coerce to string)
{ :name: >STR
  :args: #1
  :hint: "Nearest string representation of an object."
  :table: 
    { 
      { num>str Types.Float } 
      { num>str Types.Integer } 
      { ~() Types.String }
      { str>str Types.Comment }
      { :: eval lastcall ; Types.Quote }
      { sym>str Types.Symbol }
      { :: len "{ … }" "{ }" ifte ;
        Types.List }
      { :: len ":: … ;" ":: ;" ifte ;
        Types.Code }
      { :: bin> #4 rolld #3 dropn sym>str ;
        Types.Builtin }
      { :: tag> ": " +str ":" swap +str
           swap lastcall +str ;
        Types.Tag }
      { :: type Types.n swap get " object)" +str 
          "(" swap +str ; 
        Types.Any } } }
I*.stobin

(Basic-type VAL)
{ :name: VAL
  :args: #1
  :hint: "Like BASIC, turn a string into a float, 0 if 0, 0 also if error."
  :table: { { basicval Types.String } } }
I*.stobin

