':: "dev/" 'BASDIR STO "" "dev/boot.rpl" I*.dsk> ;
'boot STO

'i** EXISTS
'::
  (I* 'I* STO
  i** DIR ':: DUP 'i** SWAP + RCL SWAP 'I* SWAP + STO ; FOREACH DROP)
  i** CP 'I* STO
  ':: "read" FOPEN #0 READ 
    " ;" + ":: " SWAP + pærse ; 'pædisk STO 
  ':: "read" FOPEN #0 READ peval ; 'I*.dsk> STO ;
IFT
  Pærse STATICN 'Pærse STO 

(Enable compilation of sysrpl.)
i** 'Pærse.symbols STO

(Has, lifted from the builtin of the same name.)
'   :: 
      >quote swap dup >quote swap len 
      ':: 
        idx length < 
        ':: 
          list idx get term == #1 
          ':: 
            idx #1 +int 'idx sto loop ; 
          ifte ; 
        #0 ifte ; 
      dup { loop length list term :idx: #0 } local ;
'Pærse.symbols.has STO

