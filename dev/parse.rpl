( CODSWALLOP RPL, a zen garden
  #####################################################
  Parser )

(XXX Reloader)
':: "dev/parse.rpl" DSK> ; 'rp STO

(Basic directory tree.)
[dir:
  :default: 
  [dir:
    :spaces: { "" " " "
" "	" }
    :reserved: { "}" "{" ":" ";" "[" "]" "'" "\"" }
    :newline: "
"
    :maxdigits: #15 
    :margin: #78 
    :symdir: builtins 
    :nocomment: #0 ]
  :common: [dir: ]
  :type: [dir: ]
  :symbols: [dir: ] ]
'Pærse STO

(List of parse routines, generally one per type, in order of precedence.)
{ 
  Pærse.type.List
  Pærse.type.Code
  Pærse.type.Tag
  Pærse.type.String 
  Pærse.type.Integer
  Pærse.type.Float 
  Pærse.type.Quote 
  Pærse.type.Comment
  Pærse.type.Directory
  Pærse.type.Symbol
  Pærse.type.Else }
'Pærse.default.parsers STO


(Super basic string to object parser, user side call.)
':: 
  ':: 
    skip next valid
    ':: DUP nulltoken SAME ':: DROP pærseded ; IFT ;
    'pærseded
    IFTE ;
   { :nocomment: #1 } Pærse.default.environment ;
'pærse STO

(Pærse and evaluate.)
':: 
  '::
    ':: 
      skip next valid
      ':: 
        DUP nulltoken SAME 'DROP 
        'EVAL IFTE ;
      'pærseded
      IFTE
      stop NOT ;
    REP ;
  { :nocomment: #1 } Pærse.default.environment ;
'pæval STO

(Report a parse error.)
'::
  (First back up the cursor if it's overrun the text.)
  cursor length >= ':: length #1 -int 'cursor sto ; ift
  (Then begin the chastizing.)
  "Your words fail to become actions." disp "" disp
  cursor dup error len
  '::
    (Scan to the beginning of the text to find our line number.)
    cursor
    ::
      dup
      ':: dup text swap get Pærse.default.newline ==
        ':: line #1 +int 'line sto ; ift
        #1 -int dup ;
      #0 ifte 
      'rst ift ;
    drop
    (Back up to the beginning of the string or the last newline.)
    :: lcurs
      ':: text lcurs #1 -int dup 'lcurs sto get Pærse.default.newline != ;
      #0
      ifte
      'rst ift ;
    (Then push forward to the next newline or EOF.)
    :: text rcurs #1 +int dup length <
      ':: dup 'rcurs sto get Pærse.default.newline != ;
      ':: drop drop #0 ;
      ifte
      'rst ift ;
    (Denote the line where we found our trouble.)
    "On line " line num>str +str ":" +str disp
    (Clip the relevant text, if any, and display it.)
    length ':: text lcurs rcurs subs ; "" ifte
    dup len Pærse.default.margin >
    ':: Pærse.default.margin #1 - left "…" +str ; ift
    disp
    (Point to the user's troubles on the line.)
    " " cursor lcurs -int dup rotd *str "↑" +str disp
    (And, within limits, center the error under the arrow.)
    errlen #2 /int -int
    #0 dup2 > rotd ifte
    Pærse.default.margin errlen -int dup2 < rotd ifte
    " " SWAP *str error +str disp ;
  { errlen lcurs rcurs :linepos: #0 :line: #1 } local ;
'pærseded STO

(Default variable environment for parsing text.)
'::
  { text length
    :cursor: #0
    :valid: #0
    :stop: #0
    :altmode: #0
    :error: "There is nothing here" 
    :onechar: Pærse.common.onechar
    :next: Pærse.common.next
    :skip: Pærse.common.skip
    :composite: Pærse.common.composite
    :mkvalid: Pærse.common.mkvalid
    :mkinvalid: Pærse.common.mkinvalid
    :getstring: Pærse.common.getstring
    :getnumber: Pærse.common.getnumber
    :postsym: Pærse.default.postsym
    :maxdigits: Pærse.default.maxdigits
    :spaces: Pærse.default.spaces
    :reserved: Pærse.default.reserved 
    :parsers: Pærse.default.parsers
    :nocomment: Pærse.default.nocomment
    :nulltoken: "(null)" }
  SWAP + 
  #3 PICK LEN #4 ROLLD
  LOCAL ;
'Pærse.default.environment STO

(Skip cursor past whitespace and set the stop flag if we're at the end.)
':: 
  (Are we at the end?)
  cursor length <
  '::
    (Advance through any whitespace.)
    spaces text cursor get has dup
    ':: cursor #1 +int 'cursor sto ;
    ift ;
  (Set the stop flag at EOF and also just stop.)
  ':: #1 'stop sto #0 ;
  ifte
  'rst ift ;
'Pærse.common.skip STO

(Return the next character and True (really the cursor position) or only False.
 Do not set stop flag.)
':: 
  (Are we already at the end?)
  cursor length <
  (No, fetch character and advance cursor.)
  ':: text cursor get cursor #1 +int dup 'cursor sto ;
  (Yes, just return false.)
  #0 
  ifte ;
'Pærse.common.onechar STO

(Mark the run as valid, and skip cursor ahead.  Resets the alt mode flag. 
 Accepts the object and a new cursor location.  The generated object remains
 on the stack.)
'::
  'cursor sto #1 'valid sto #0 'altmode sto
  skip ;
'Pærse.common.mkvalid STO

(Mark the run as invalid and record an error.  Accepts an error string and a
 cursor location.)
'::
  'cursor sto 'error sto #0 'valid sto #1 'stop sto ;
'Pærse.common.mkinvalid STO

(Advance parser through one object.  This provides 'start' as an initial
 cursor position in case of errors partway through.)
'::
  (Silently refuse to run a red light.)
  stop not
  '::
    (Alt mode flags and in-between whitespace are soaked up here.)
    :: 
      text cursor get dup dup "`" == swap "~" == or
      '::
        "`" == 'altmode sto
        cursor #1 +int 'cursor sto
        skip stop not ;
      ':: drop #0 ;
      ifte
      'rst ift ;
    (Check again to make sure we're not done.)
    stop not
    '::
      (Clear the valid flag and step through our known parsers.)
      #0 'valid sto
      parsers len cursor
      '::
        max
        ':: 
          parsers idx gete
          idx #1 +int 'idx sto
          (Repeat until something flagged valid, stopped, or there
           are no more parsers to try.)
          valid stop or not idx max < and ;
        #0 ifte
        'rst ift ;
      { start max :idx: #0 }
      local ; 
    ift ;
  ift ;
'Pærse.common.next STO

(Symbol postprocessing.  Return some object instead of a symbol if it's in a
 substitution directory.)
':: 
  dup 'Pærse.symbols swap +sym dup exists
  ':: rcl swap drop ;
  'drop
  ifte ;
'Pærse.default.postsym STO

(### Parse helpers.  These are common routines that can be helpful for
 studying multiple different types of objects.)

(Retrieve the contents of a list.  Accepts:
  typeok: Secondary check object for restricted composites like directories
  delimiter: Closing character to stop at)
'::
  (Skip any whitespace after the opening delimiter, and store
    the current alt mode.)
  skip altmode cursor
  '::
    ::
      (Before every loop, make sure we're not stopped.)
      stop not
      '::
        (Check to see if the cursor is on a closing delimiter.)
        text cursor get delimiter !=
        (Not a delimiter, try for an object.)
        '::
          (Reset alt mode for each object.)
          localalt 'altmode sto next 
          (Check for both a valid object and an appropriate one.)
          valid 'typeok #0 ifte
          '::
            (Suppress null objects as needed.)
            dup nulltoken ==ref
            'drop ':: count #1 +int 'count sto ;
            ifte cursor 'localcursor sto #1 ;
          (Invalid object, so drop everything we have so far and bail.
            Include a valid but inappropriate one in our DROP.)
          ':: count dropn #0 ;
          ifte ;
	(If we're on a delimiter, force a valid flag and bail.)
        ':: #1 'valid sto #0 ;
        ifte ;
      #0 ifte 
      'rst ift ;
    valid count ift ;
  { :count: #0 localcursor localalt delimiter typeok } local ;
'Pærse.common.composite STO

(Retrieve a text string up to a closing character or EOF, and do a
 rudimentary escape character thing.  Does not set stop.)
'::
  ':: 
    ""
    ::
      cursor length <
      '::
        text cursor get dup delimiter !=
        '::
          "\\" ==
          ':: cursor #1 +int 'cursor sto ; ift
          cursor length <
          ':: text cursor get +str
            cursor #1 +int 'cursor sto #1 ;
          #0 ifte ;
        ':: drop #0 ;
        ifte ;
      #0 ifte
      'rst ift ;
    ;
  { delimiter }
  LOCAL ;
'Pærse.common.getstring STO

(Partly convert a string to an integer.  The purpose here is to extract a
 sequence of digits into an integer.  Can be called out of bounds.
 Returns:
 3: Integer value
 2: Character now under cursor
 1: Digit count)
'::
  #0
  '::
    cursor length <
    '::
      text cursor get asc> #48 -int dup dup #0 >= swap #9 <= and
      ':: 
        SWAP #10 *int +int count #1 +int 
        'count sto cursor #1 +int 'cursor sto
        cursor length < ;
      ':: drop #0 ;
      ifte
      max #1 -int dup 'max sto and 
      'rst ift ;
    ift
    cursor length <
    ':: text cursor get ;
    ""
    ifte
    count ;
  { :count: #0 :max: #20 } local ;
'Pærse.common.getint STO


(### Per type parsers.  These will either return a fully formed object by
 calling mkvalid, or fail by setting an error message with mkinvalid, or lay
 no claim at all by doing and returning nothing.)

'::
  text cursor get "#" ==
  '::
    cursor #1 +int 'cursor sto
    cursor length < ':: text cursor get ; "" ifte
    (Leave a sign multiplier on the stack.)
    dup "+" ==
    ':: drop cursor #1 +int 'cursor sto #1 ;
    ':: "-" ==
      ':: cursor #1 +int 'cursor sto #-1 ;
      #1
      ifte ;
    ifte
    Pærse.common.getint
    swap Pærse.default.spaces swap has and
    ':: *int cursor mkvalid ;
    ':: drop drop "Pound town is only for valid integers" start mkinvalid ;
    ifte ;
  ift ;
'Pærse.type.Integer STO

'::
  '::
    (Set first sign flag and advance cursor if needed.)
    text cursor GET DUP "+" ==
    ':: DROP cursor #1 + 'cursor STO ;
    ':: "-" == 
      ':: cursor #1 + 'cursor STO
        #-1 '-mantissa STO ;
      IFT ;
    IFTE

    (Only play Number Or Error if sign is followed with number stuff.)
    cursor length < ':: text cursor GET ; " " IFTE DUP
    "." == OVER "-" == OR OVER "+" == OR 
    SWAP ASC> DUP #48 >= SWAP #57 <= AND OR
    '::
      (Grab an integer portion, if any.)
      Pærse.common.getint 'iplen STO
      (Now see if we've arrived at a fractional portion.)
      DUP "." ==
      '::
        (There is a fractional portion coming up.)
        DROP cursor #1 + 'cursor STO
        Pærse.common.getint 'fplen STO ;
      ':: (No fractional portion.) #0 SWAP ;
      IFTE
      (Generate a signed integer mantissa.)
      ROT #10 fplen ^ * -mantissa * ROT + i**.num>float SWAP
      DUP "e" == iplen fplen OR AND
      '::
        (Try to read an exponent, sign first.)
        cursor #1 + DUP 'cursor STO length <
        '::
          DROP text cursor GET
          DUP "+" ==
          ':: DROP cursor #1 + 'cursor STO ;
          ':: "-" ==
            ':: cursor #1 + 'cursor STO
              #-1 '-exponent STO ;
            IFT ;
          IFTE ;
        IFT
        Pærse.common.getint ;
      ':: (No exponent at all, pretend it's valid.) #0 SWAP #1 ;
      IFTE
      (Check for closing whitespace or EOT.)
      SWAP Pærse.default.spaces SWAP HAS
      (Verify we got a valid exponent and either part of the mantissa.)
      AND fplen iplen OR AND
      (Try not to overflow the underlying data type.)
      OVER -exponent * iplen + #310 < AND
      ':: (We made it!  Set the sign on the exponent and proceed.)
        -exponent * fplen - i**.num>float 10 SWAP ^ * cursor mkvalid ;
      ':: (We failed.)
         DROP DROP "What kind of float is this" start mkinvalid ;
      IFTE ;
    ':: (Reset cursor in case we moved it.) start 'cursor STO ;
    IFTE ;
  { :-mantissa: #1 :-exponent: #1 :iplen: #0 :fplen: #0 } LOCAL ;
'Pærse.type.Float STO

(List)
'::
  (Catch spurious closing braces.)
  text cursor get dup "}" ==
  ':: drop "Wherever this was supposed to go, it wasn't here" cursor mkinvalid ;
  '::
    "{" ==
    '::
      cursor #1 +int 'cursor sto #1 "}" composite valid
      (Let any downstream error slip through if invalid.)
      ':: 
        stop
        (Valid and stopped means we never found our closing brace.)
        ':: dropn "Somewhere, a list is missing its }" start mkinvalid ;
        `(Otherwise we made it, with a list of objects and a count on the
          stack.)
        ':: >lst cursor #1 +int mkvalid ;
        ifte ;
      ift ;
    ift ;
  ifte ;
'Pærse.type.List STO

(Code, basically a carbon copy of a list.)
'::
  text cursor get ";" ==
  ':: "Perhaps this should be somewhere else" cursor mkinvalid ;
  '::
    text cursor dup #1 +int subs "::" ==
    '::
      cursor #2 +int 'cursor sto #1 ";" composite valid
      ':: stop
        ':: dropn "Semicolons are cool, you should try one more" start mkinvalid ;
        ':: >code cursor #1 +int mkvalid ;
        ifte ;
      ift ;
    ift ;
  ifte ;
'Pærse.type.Code STO

(Directory, one more variation on the theme.  This checks for only tags and
 builds a linked list by itself.)
'::
  text cursor get "]" ==
  ':: "Perhaps this should be somewhere else" cursor mkinvalid ;
  '::
    text cursor dup #4 +int subs "[dir:" ==
    '::
      cursor #5 +int 'cursor sto
      (Secondary validation to make sure only tags are making it in.
       Null tokens can slip through since they're silently dropped.)
      ':: dup dup nulltoken ==ref swap type Types.Tag == or
        #1
        ':: 
          "Directories can only contain tags" localcursor mkinvalid drop #0 ;
        ifte ;
      "]" composite valid
      ':: stop
        ':: dropn "You should find space in your life for a ]" start mkinvalid ;
        '::
          (Starting with the last directory object, string up all them tags.) 
          lastobj swap ':: >dir ; swap *code eval
          (And pop a firstdir on the front.)
          nulltag swap >dir
          cursor #1 +int mkvalid ;
        ifte ;
      ift ;
    ift ;
  ifte ;
'Pærse.type.Directory STO

(Tag, janky janky right now fix it pls)
'::
  text cursor GET ":" ==
  ':: 
    cursor #1 + 'cursor STO
    `(Get the string enclosed by :. If it's empty, it was probably a ::.)
    ":" getstring DUP LEN 
    ':: >SYM
      cursor #1 + 'cursor STO skip
      next SWAP >TAG ;
    `(Back cursor off if we aren't doing anything.)
    ':: DROP cursor #1 - 'cursor STO ;
    IFTE ;
  IFT ;
'Pærse.type.Tag STO

(String)
'::
  `(All strings with a quote.)
  text cursor get "\"" == 
  '::
    cursor #1 +int 'cursor sto "\"" getstring
    cursor length < ':: text cursor get "\"" == ; #0 ifte
    ':: cursor #1 +int mkvalid ;
    `(They also end with a quote.)
    ':: drop
      "Strings don't just start with quotes"
      start mkinvalid ;
    ifte ;
  ift ;
'Pærse.type.String STO

(Quote)
'::
  (All quotes begin with '.)
  text cursor get "'" ==
  '::
    (Catch EOF.)
    cursor #1 +int 'cursor sto skip stop
    ':: "Quote... what" start mkinvalid ;
    '::
      next valid
      ':: 
	(Disappearing objects can't go into quotes.)
        dup nulltoken ==ref
        ':: drop "You should put something corporeal here" start #1 +int
          mkinvalid ;
        ':: >quote cursor mkvalid ;
        ifte ;
      ift ;
    ifte ;
  ift ;
'Pærse.type.Quote STO

(Comment)
'::
  `(Catch close parens as a public service.)
  text cursor get dup ")" ==
  ':: "This looks like a shut and open case" cursor mkinvalid ;
  ift "(" ==
  '::
    '::
      :: cursor #1 +int dup 'cursor sto length < depth and
        '::
          (Count nested parentheses up and down as needed.)
          text cursor get dup "(" == swap ")" == -int depth +int 'depth sto
          #1 ;
        #0
        ifte
        'rst ift ;
      depth
      (Catch an unclosed comment.)
      ':: "These remarks have gone on far too long" start mkinvalid ;
      (And pick between a real object and the null token according to alt
       mode.  The null token is shunned in several places.)
      ':: text start #1 +int cursor #2 -int subs str>rem
        altmode nocomment or ':: drop nulltoken ; ift
        cursor mkvalid ;
      ifte ; 
    { :depth: #1 } local ;
  ift ;
'Pærse.type.Comment STO

(Symbol: one or more dot-separated names.  Returns a list of strings for now.)
'::
  (Make no claim if at EOT, whitespace, or reserved.)
  '::
    ::
      (Read one name segment, stopping at dot, space, reserved, or EOT.)
      ""
      ::
        cursor length <
        '::
          text cursor get dup
          reserved swap has
          '::
            drop drop "Breakin shit babes" start mkinvalid #0 ;
          '::
            dup "." == over spaces swap has or
            ':: drop #0 ;
            ':: +str cursor #1 +int 'cursor sto #1 ;
            ifte ;
          ifte ;
        #0 ifte 
        'rst ift ;
      (Don't try to continue if an error is already flagged.)
      stop
      #0
      '::
        (An empty segment is not a valid name.)
        dup len
        '::
          count #1 +int 'count sto
          (Consume dot and continue, if there is one.)
          cursor length <
          ':: text cursor get "." ==
            ':: cursor #1 +int 'cursor sto #1 ;
            #0 ifte ;
          #0 ifte ;
        ':: drop "A symbol name must not be empty" start mkinvalid #0 ;
        ifte ;
      ifte 
      'rst ift ;
    stop not
    '::
      (Logic here: alt always recalls, postsym derefs from its own
       directory or passes raw symbol otherwise.)
      count >sym altmode
      ':: dup exists
        ':: rcl cursor mkvalid ;
        ':: drop "This symbol must exist at parse time" start mkinvalid ;
        ifte ;
      ':: postsym cursor mkvalid ; 
      ifte ;
    ift ;
  { :count: #0 } local ;
'Pærse.type.Symbol STO

(This is where we end up when we're outta chances.)
'::
  "Whatever this is, it isn't" cursor mkinvalid ;
'Pærse.type.Else STO 

