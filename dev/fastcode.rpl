( CODSWALLOP RPL, a zen garden
  #####################################################
  Fast code )

(This is an early-loaded standard library, containing routines mostly
 written with internals, for things not requiring the elaborate type
 checking normally employed.)

(DROP!: Clear the stack.)
{ :name: DROP!
  :args: #0
  :hint: "Drop everything from the stack."
  :table: { { :: stack len dropn ; } } }
I*.stobin


(REP: repeat, using code modification.
 This version just appends recursion, duplicates the whole program
 to store itself in its own local variable, and goes to town.)
{ :name: REP
  :args: #1
  :hint: "Repeatedly evaluate a code object until it returns 0." 
  :table:
  { { :: 
        ':: '_rep bin.IFT ; 
        catcode dup 
        { _rep } local ; Types.Code } } }
I*.stobin


(RCLD: Recall an object or return a default if the name does not exist.)
{ :name: RCLD
  :args: #2
  :hint: "Recall an object if it exists, otherwise return a default value."
  :table:
  { { ::
        swap dup exists
        ':: rcl swap ; ift drop ;
       Types.Symbol Types.Any } } }
I*.stobin


(HAS: See if a value exists in a list.  This doesn't evaluate any
 user code, so it was safe to implement with internals for a smidge
 of extra speed.  Is now taken from parser.)
(':: 
  >quote
  swap dup >quote swap len
  ':: idx length <
    ':: list idx get term ==
      #1
      ':: idx #1 +int 'idx sto loop ;
      ifte ;
    #0 
    ifte ; 
  dup { loop length list term :idx: #0 } local ;
'has STO)

{ :name: HAS
  :args: #2
  :hint: "Check to see if a list on line 2 contains something like the item on line 1."
  :table: { { has Types.List Types.Any } } }
I*.stobin


(READF: Read an entire file split into lines.)
':: "r" fopen
  '::
    { }
    file feof not
    ':: 
      file freadline +list file feof 
      self swap 'drop 'eval ifte ;
    ift file fclose ; 
  { file } local ;
'readf STO

{ :name: READF
  :args: #1
  :hint: "Read an entire file and return it as a list of strings, one per line."
  :table: { { readf Types.String } } }
I*.stobin


(UNPARSE: Turn an object back into a string with delimiters and decoration.)

{ :name: UNPARSE
  :args: #1
  :hint: "Un-parse an object back into a string, more or less."
  `:table: 
    { 
      { num>str 
        Types.Float } 
      { :: num>str "#" swap +str ;
        Types.Integer } 
      { :: "\"" +str "\"" swap +str ;
        Types.String }
      { :: ")" +str "(" swap +str ;
        Types.Comment }
      { :: eval lastcall "'" swap +str ;
        Types.Quote }
      { sym>str
        Types.Symbol }
      { :: len "{ … }" "{ }" ifte ;
        Types.List }
      { :: len ":: … ;" ":: ;" ifte ;
        Types.Code }
      { :: bin> #4 rolld #3 dropn ;
        Types.Builtin }
      { :: tag> ": " +str ":" swap +str
           swap lastcall +str ;
        Types.Tag }
      { romid
        Types.Internal }
      { :: type Types.n swap get " object)" +str 
          "(" swap +str ; 
        Types.Any } } }
I*.stobin

(Display.)
{ :name: DISP
  :args: #1
  :hint: "Print any object in human-readable form to the screen."
  :table: { { disp Types.String } 
            { :: bin.>STR disp ; Types.Any } } }
I*.stobin

(Display with no newline.)
{ :name: DISPN
  :args: #1
  :hint: "DISP without newline."
  :table: { { dispn Types.String } 
            { :: bin.>STR dispn ; Types.Any } } }
I*.stobin

(String concatenation stuff dependent upon >STR.  For the moment this
 is hardcoded, but eventually dispatch tables will be possible to merge.)
'bin.+ bin> #4 pick
{ :: swap bin.>STR swap +str ; Types.Any Types.String }
#9 put
{ :: bin.>STR +str ; Types.String Types.Any }
#7 put
'bin.+ swap I*.setdispatch #4 dropn
